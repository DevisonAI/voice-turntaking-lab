# Copy to .env — never commit secrets
# Live: python3 -m src.main --live --audio fixtures/hello.wav --write-session
#
# === Required: hire-signal voice hops ===
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
#
# === Required: LLM middle hop (swappable) ===
# Default for this portfolio: Anthropic (Claude). OpenAI remains optional.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional alias (used if LLM_API_KEY empty and LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=
#
# Optional OpenAI path (only if you switch LLM_PROVIDER=openai):
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
#
# Anthropic model override (optional):
# LLM_MODEL=claude-3-5-haiku-latest
#
# Deepgram / ElevenLabs knobs (optional)
# DEEPGRAM_MODEL=nova-2
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
